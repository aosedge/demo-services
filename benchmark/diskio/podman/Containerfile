# Build from the parent "diskio" directory so this can COPY the shared benchmark source
# (../src/diskio_benchmark.py, the same script AosCore's config.yaml.in deploys) without
# duplicating it here:
#
#   cd benchmark/diskio
#   podman build -f podman/Containerfile -t benchmark-diskio:latest .
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends fio \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /
COPY src/diskio_benchmark.py /diskio_benchmark.py
COPY podman/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
