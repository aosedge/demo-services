# One Deployment per timing item, cloned by scripts/create_services.py from the first document
# separator on (so nothing above that separator is repeated - and this header must not contain one
# itself, not even inside a comment). It renders to manifest.yaml, applied with kubectl.
#
# Instances are the Deployment's replicas, so each instance is a pod of its own (a pause container
# plus one container), which is how Kubernetes scales a workload.
#
# This one template covers every Operational Speed chapter's shape:
#   - "Install new deployable items"/"Install cached deployable items": N separate items, each 1
#     instance - vary --num-services (1/8/16), leave --num-instances at its default (1).
#   - "Start/stop already installed instances": 1 (or more, at the 128/256 tiers) item(s) scaled
#     to up to 64 instances each - vary --num-instances, and --num-services only past 64 total.
#
# The image is the one the Podman benchmark builds and pushes (podman/Containerfile) - nothing is
# rebuilt for k3s.
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: timing-@SERVICE_ID@

spec:
  replicas: @NUM_INSTANCES@
  selector:
    matchLabels:
      app: timing-@SERVICE_ID@

  template:
    metadata:
      labels:
        app: timing-@SERVICE_ID@

    spec:
      # benchmark-timing installs no SIGTERM handler, and as PID 1 the kernel then ignores SIGTERM
      # entirely - so stopping a pod would wait out its whole termination grace period before
      # SIGKILL. With a shared process namespace the pod's pause container is PID 1 instead (it
      # reaps and forwards signals like an init), the same reason the Podman compose file sets
      # `init: true`. Without this, "Stop instances" would measure the grace period, not stopping.
      shareProcessNamespace: true

      # benchmark-timing's own default (--victoria-url http://victoriametrics:8428) then just
      # works, without needing a --victoria-url override here.
      hostAliases:
        - ip: "10.0.0.100"
          hostnames:
            - "victoriametrics"

      containers:
        - name: timing
          image: @REGISTRY_HOST@/benchmark-timing-@SERVICE_ID@:latest

          # Kubernetes' default for a :latest tag is Always, which asks the registry on every
          # container start even when the image is already there; IfNotPresent is the same
          # "pull only what's missing" behavior podman-compose has, so a cached item starts from
          # the local copy.
          imagePullPolicy: IfNotPresent
