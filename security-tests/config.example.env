# Copy to config.env and fill in. config.env is git-ignored - never commit real values.

# ---------------------------------------------------------------- target
# local-ubuntu : QEMU VM on this machine (implemented)
# aws          : AosCore VM on AWS EC2 (phase 2, not implemented)
AOS_TARGET=local-ubuntu

# ---------------------------------------------------------------- AosCloud
# Your own tenant. Nothing here is shipped with the suite.
AOS_CLOUD_API=https://api.<your-cloud>:10000/api/v11/
AOS_OEM_P12=/absolute/path/to/aos-user-oem.p12
AOS_SP_P12=/absolute/path/to/aos-user-sp.p12
AOS_UNIT_SET_ID=<uuid of your validation unit-set>
AOS_SUBJECT_ID=<uuid of your test subject>

# ---------------------------------------------------------------- VM
AOS_VM_IMAGE=/absolute/path/to/aos-vm-main-qemux86-64.qcow2
AOS_VM_IMAGE_SHA256=cdf6376d663cdcc77ca707b776cb3a0e84d5511606527102a2a471e46a1725fc
AOS_VM_ACCEL=kvm
# Disk presentation. Must match the image: qemux86-64 -> scsi, genericx86-64 -> nvme.
AOS_VM_DISK_IF=scsi
AOS_VM_CPUS=4
AOS_VM_MEM=4G
AOS_VM_SSH_PORT=12222
AOS_VM_PROV_PORT=18089
AOS_VM_EXTRA_PORT=18090
# Guest login used on the serial console (the image starts no SSH server).
AOS_VM_SSH_USER=root
AOS_VM_SSH_PASSWORD=Password1
AOS_VM_BIOS=/usr/share/ovmf/OVMF.fd
# Where the emulated network answers DNS. Only used when the unit cannot
# resolve the cloud endpoint with its own configuration.
AOS_EMULATED_DNS=10.0.0.3

# ---------------------------------------------------------------- probe
# "auto" gives each run its own version. A fixed value makes the cloud keep
# serving the bundle it already has, so the probe would carry a stale marker.
AOS_PROBE_VERSION=auto
